{
  "name": "@sprintengine/client-runtime",
  "version": "0.1.0",
  "description": "What every SprintEngine Studio client runs: the Studio protocol's client over any transport, and the supervisor that keeps its connection up. No Node, DOM or React; runs in React Native, a browser and Node.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprintengine/sprintengine.git",
    "directory": "packages/client-runtime"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/cjs/public.js",
  "module": "./dist/esm/public.js",
  "types": "./dist/cjs/public.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/public.d.ts",
        "default": "./dist/esm/public.js"
      },
      "require": {
        "types": "./dist/cjs/public.d.ts",
        "default": "./dist/cjs/public.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@sprintengine/studio-protocol": "^0.1.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build"
  }
}
