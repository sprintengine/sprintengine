{
  "$schema": "../node_modules/@sprintengine/extension-sdk/extension.schema.json",
  "manifestVersion": 1,
  "id": "{{id}}",
  "version": "0.1.0",
  "engines": {
    "studio": ">={{studioVersion}}"
  },
  "tier": "ui",
  "name": "{{displayName}}",
  "description": "{{displayName}}, an extension for SprintEngine Studio.",
  "permissions": ["workspace-files:read", "workspace-files:write"],
  "contributes": {
    "customEditors": [
      {
        "id": "pairs",
        "title": "Key-value pairs",
        "icon": "notes",
        "entry": "src/pairs.ts",
        "extensions": [".kv"]
      }
    ]
  }
}
