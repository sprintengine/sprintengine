{
  "$schema": "../node_modules/@sprintengine/extension-sdk/extension.schema.json",
  "manifestVersion": 1,
  "id": "{{id}}",
  "version": "0.1.0",
  "engines": {
    "studio": ">={{studioVersion}}"
  },
  "tier": "worker",
  "name": "{{displayName}}",
  "description": "{{displayName}}, an extension for SprintEngine Studio.",
  "permissions": ["tools:contribute", "workspace:read"],
  "main": "src/main.ts",
  "contributes": {
    "mcpTools": [
      {
        "name": "{{toolPrefix}}_word_count",
        "description": "Count the words, lines and characters in a piece of text.",
        "access": "read",
        "inputSchema": {
          "type": "object",
          "properties": { "text": { "type": "string", "description": "The text to count." } },
          "required": ["text"]
        }
      },
      {
        "name": "{{toolPrefix}}_open_workspaces",
        "description": "List the workspaces open in SprintEngine Studio, with the folder each one works in.",
        "access": "read",
        "inputSchema": { "type": "object", "properties": {} }
      }
    ]
  }
}
