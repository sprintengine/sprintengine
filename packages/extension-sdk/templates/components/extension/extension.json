{
  "$schema": "../node_modules/@sprintengine/extension-sdk/extension.schema.json",
  "manifestVersion": 1,
  "id": "{{id}}",
  "version": "0.1.0",
  "engines": {
    "studio": ">={{studioVersion}}"
  },
  "tier": "ui",
  "name": "{{displayName}}",
  "description": "{{displayName}}, an extension for SprintEngine Studio.",
  "contributes": {
    "panels": [
      {
        "id": "checklist",
        "title": "Checklist",
        "icon": "check",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  }
}
