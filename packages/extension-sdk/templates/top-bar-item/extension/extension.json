{
  "$schema": "../node_modules/@sprintengine/extension-sdk/extension.schema.json",
  "manifestVersion": 1,
  "id": "{{id}}",
  "version": "0.1.0",
  "engines": {
    "studio": ">={{studioVersion}}"
  },
  "tier": "ui",
  "name": "{{displayName}}",
  "description": "{{displayName}}, an extension for SprintEngine Studio.",
  "permissions": ["settings:own"],
  "contributes": {
    "topBarItems": [
      {
        "id": "timer",
        "title": "Focus timer",
        "icon": "schedule",
        "door": "timer"
      }
    ],
    "doors": [
      {
        "id": "timer",
        "title": "Focus timer",
        "icon": "schedule",
        "entry": "src/timer.ts"
      }
    ]
  }
}
