{
  "$schema": "../node_modules/@sprintengine/extension-sdk/extension.schema.json",
  "manifestVersion": 1,
  "id": "{{id}}",
  "version": "0.1.0",
  "engines": {
    "studio": ">={{studioVersion}}"
  },
  "tier": "worker",
  "name": "{{displayName}}",
  "description": "{{displayName}}, an extension for SprintEngine Studio.",
  "permissions": [
    "backlog:read",
    "conversation:own"
  ],
  "main": "dist/main.cjs",
  "contributes": {
    "commands": [
      {
        "id": "plan-in-chat",
        "title": "Plan in a chat",
        "when": "workspace"
      }
    ],
    "menus": [
      {
        "where": "backlog.item",
        "command": "plan-in-chat"
      }
    ]
  }
}
