{
  "name": "{{id}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{displayName}} — a SprintEngine Studio extension ({{templateTitle}} template).",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:ui --if-present && npm run build:main --if-present",
    "build:test": "esbuild \"test/**/*.test.ts\" --bundle --platform=node --format=esm --target=node22 --packages=external --jsx=automatic --loader:.css=text --outbase=test --outdir=test/.build --out-extension:.js=.mjs --log-level=warning",
    "test": "npm run build:test && node --test test/smoke.test.mjs \"test/.build/**/*.test.mjs\"",
    "validate": "node scripts/validate.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run validate",
    "dev:install": "npm run build && node scripts/dev-install.mjs",
    "keygen": "sprintengine-extension keygen --out \"~/.sprintengine/keys/{{id}}.key\""
  },
  "devDependencies": {
    "@sprintengine/extension-sdk": "^{{sdkVersion}}",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
