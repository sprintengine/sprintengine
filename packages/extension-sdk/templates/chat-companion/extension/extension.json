{
  "$schema": "../node_modules/@sprintengine/extension-sdk/extension.schema.json",
  "manifestVersion": 1,
  "id": "{{id}}",
  "version": "0.1.0",
  "engines": {
    "studio": ">={{studioVersion}}"
  },
  "tier": "worker",
  "name": "{{displayName}}",
  "description": "{{displayName}}, an extension for SprintEngine Studio.",
  "permissions": [
    "conversation:own",
    "chat:draft",
    "notifications:show"
  ],
  "main": "dist/main.cjs",
  "background": true,
  "contributes": {
    "panels": [
      {
        "id": "chats",
        "title": "{{displayName}}",
        "icon": "chat",
        "entry": "dist/companion.js"
      }
    ]
  }
}
