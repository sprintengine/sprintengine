{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprintengine.dev/schemas/extension.schema.json",
  "type": "object",
  "title": "SprintEngine Studio extension manifest",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 2048,
      "description": "JSON Schema URL for editor completion. Studio ignores it.",
      "x-since": "0.13.0"
    },
    "manifestVersion": {
      "const": 1,
      "description": "The manifest format. Always `1`.",
      "x-since": "0.13.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Extension id, kebab-case. Studio installs it under `<publisher>.<id>`, the publisher derived from where it came from (`local` for a folder). Ids starting `studio-` or `sprintengine-` install only from Studio’s own catalogue.",
      "x-since": "0.13.0",
      "examples": [
        "notes"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "description": "The extension’s version, semver.",
      "x-since": "0.13.0",
      "examples": [
        "1.0.0"
      ]
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "studio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^>=(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "description": "The oldest Studio it runs on, as `>=x.y.z`: at least the newest “since” of any field it uses.",
          "x-since": "0.13.0",
          "examples": [
            ">=0.13.0"
          ]
        }
      },
      "required": [
        "studio"
      ],
      "description": "The Studio versions it runs on.",
      "x-since": "0.13.0"
    },
    "tier": {
      "type": "string",
      "maxLength": 16,
      "enum": [
        "content",
        "declarative",
        "ui",
        "worker"
      ],
      "description": "The most authority it needs, least first: `content` (syntaxes, keybindings, status bar items, settings: data Studio draws, no approval asked), `declarative` (commands, menus, top bar items), `ui` (panels, doors, settings sections, custom editors, drawn by its own code), `worker` (`main`, running in the background). Each carries what the ones below it do; a contribution above it fails validation.",
      "x-since": "0.13.0",
      "examples": [
        "ui"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Display name.",
      "x-since": "0.13.0",
      "examples": [
        "Notes"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 512,
      "description": "One or two sentences shown with the name.",
      "x-since": "0.13.0"
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:<>\"|?*\\u0000-\\u001f]+(?:\\.[Pp][Nn][Gg]|\\.[Ss][Vv][Gg]|\\.[Jj][Pp][Gg]|\\.[Jj][Pp][Ee][Gg]|\\.[Ww][Ee][Bb][Pp])$",
      "description": "A square image shown beside the name.",
      "x-since": "0.13.0",
      "examples": [
        "assets/icon.png"
      ]
    },
    "cover": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:<>\"|?*\\u0000-\\u001f]+(?:\\.[Pp][Nn][Gg]|\\.[Ss][Vv][Gg]|\\.[Jj][Pp][Gg]|\\.[Jj][Pp][Ee][Gg]|\\.[Ww][Ee][Bb][Pp])$",
      "description": "A wide image for its listing.",
      "x-since": "0.13.0"
    },
    "screenshots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:<>\"|?*\\u0000-\\u001f]+(?:\\.[Pp][Nn][Gg]|\\.[Ss][Vv][Gg]|\\.[Jj][Pp][Gg]|\\.[Jj][Pp][Ee][Gg]|\\.[Ww][Ee][Bb][Pp])$"
      },
      "description": "Images of it at work, for its listing.",
      "x-since": "0.13.0"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9.+()-]+(?: (?:OR|AND|WITH) [A-Za-z0-9.+()-]+)*$",
      "description": "Its licence, as an SPDX expression.",
      "x-since": "0.13.0",
      "examples": [
        "MIT"
      ]
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https:\\/\\/[^\\s]+$",
      "description": "Where its source lives.",
      "x-since": "0.13.0"
    },
    "homepage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https:\\/\\/[^\\s]+$",
      "description": "Its home page.",
      "x-since": "0.13.0"
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 64,
        "enum": [
          "workspace:read",
          "workspace:operate",
          "conversation:read",
          "backlog:read",
          "backlog:operate",
          "providers:read",
          "usage:read",
          "workspace-files:read",
          "workspace-files:write",
          "storage:own",
          "settings:own",
          "secrets:own",
          "notifications:show",
          "conversation:own",
          "conversation:bypass",
          "chat:draft",
          "schedules:own",
          "agents:generate",
          "agents:companion",
          "github:api",
          "tools:contribute"
        ]
      },
      "description": "What it asks the person to allow. `content` and `declarative` extensions hold none.",
      "x-since": "0.13.0",
      "x-tier": "ui",
      "examples": [
        [
          "storage:own"
        ]
      ]
    },
    "main": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:<>\"|?*\\u0000-\\u001f]+(?:\\.[Jj][Ss]|\\.[Mm][Jj][Ss]|\\.[Cc][Jj][Ss])$",
      "description": "The worker’s entry: a module whose `activate(studio)` (its default export, or a named `activate`) registers what it serves. Worker tier only, and required by it.",
      "x-since": "0.13.0",
      "x-tier": "worker",
      "examples": [
        "dist/main.js"
      ]
    },
    "background": {
      "type": "boolean",
      "description": "`true` keeps the worker running while the extension is on.",
      "x-since": "0.13.0",
      "x-tier": "worker"
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "title": "CommandContribution",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                "description": "Command id, unique among this extension’s commands. Without `action`, running the command calls the worker method of this name (`registerMethods`, access `operate`).",
                "x-since": "0.13.0",
                "examples": [
                  "notes.clear"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "Title in the command palette and in menus.",
                "x-since": "0.13.0",
                "examples": [
                  "Clear notes"
                ]
              },
              "when": {
                "type": "string",
                "maxLength": 16,
                "enum": [
                  "global",
                  "workspace"
                ],
                "description": "Where the command is offered. `workspace` hides it while no workspace is open. Defaults to `global`.",
                "x-since": "0.13.0"
              },
              "action": {
                "type": "string",
                "maxLength": 64,
                "enum": [
                  "app.settings.open",
                  "commandPalette.open",
                  "search.everywhere",
                  "search.goToFile",
                  "chat.new",
                  "workspace.history.back",
                  "workspace.history.forward",
                  "workspace.sidebar.toggle",
                  "panel.files.toggle",
                  "panel.editor.toggle",
                  "panel.git.toggle",
                  "panel.backlog.toggle",
                  "git.refresh",
                  "git.fetch",
                  "terminal.new",
                  "usage.show"
                ],
                "description": "A Studio command this command runs. A command with an `action` is declarative and runs no extension code; one without needs the worker tier.",
                "x-since": "0.13.0",
                "examples": [
                  "panel.backlog.toggle"
                ]
              }
            },
            "required": [
              "id",
              "title"
            ]
          },
          "description": "Command palette entries.",
          "x-since": "0.13.0",
          "x-tier": "declarative"
        },
        "menus": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "title": "MenuContribution",
            "additionalProperties": false,
            "properties": {
              "where": {
                "type": "string",
                "maxLength": 32,
                "enum": [
                  "backlog.item",
                  "file",
                  "notification"
                ],
                "description": "The menu: a backlog item’s, a file’s in the Files tree, or one of this extension’s own notifications.",
                "x-since": "0.13.0"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                "description": "A command this extension contributes. Its title is the menu item’s label, and it runs with the item it was picked on.",
                "x-since": "0.13.0",
                "examples": [
                  "notes.clear"
                ]
              }
            },
            "required": [
              "where",
              "command"
            ]
          },
          "description": "Items in Studio’s own menus.",
          "x-since": "0.13.0",
          "x-tier": "declarative"
        },
        "topBarItems": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "title": "TopBarItemContribution",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Id, unique among this extension’s top bar items.",
                "x-since": "0.13.0"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "The button’s name and tooltip.",
                "x-since": "0.13.0"
              },
              "icon": {
                "type": "string",
                "maxLength": 32,
                "enum": [
                  "extension",
                  "chat",
                  "branch",
                  "folder",
                  "schedule",
                  "spark",
                  "lock",
                  "settings",
                  "check",
                  "warning",
                  "copy",
                  "notes"
                ],
                "description": "The button’s glyph. Defaults to `extension`.",
                "x-since": "0.13.0",
                "examples": [
                  "notes"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                "description": "A contributed command the button runs. Give `command` or `door`, not both.",
                "x-since": "0.13.0"
              },
              "door": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "A contributed door the button opens.",
                "x-since": "0.13.0"
              }
            },
            "required": [
              "id",
              "title"
            ]
          },
          "description": "Buttons in the top bar.",
          "x-since": "0.13.0",
          "x-tier": "declarative"
        },
        "panels": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "title": "PanelContribution",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Id, unique within this point.",
                "x-since": "0.13.0",
                "examples": [
                  "notes"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "What Studio calls it.",
                "x-since": "0.13.0",
                "examples": [
                  "Notes"
                ]
              },
              "icon": {
                "type": "string",
                "maxLength": 32,
                "enum": [
                  "extension",
                  "chat",
                  "branch",
                  "folder",
                  "schedule",
                  "spark",
                  "lock",
                  "settings",
                  "check",
                  "warning",
                  "copy",
                  "notes"
                ],
                "description": "Glyph beside the title. Defaults to `extension`.",
                "x-since": "0.13.0",
                "examples": [
                  "notes"
                ]
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:<>\"|?*\\u0000-\\u001f]+(?:\\.[Jj][Ss]|\\.[Mm][Jj][Ss])$",
                "description": "What the panel draws, as a tab in a workspace’s pane. A `.js` or `.mjs` module whose `mount(root, studio)` draws into `root` and may return a cleanup function.",
                "x-since": "0.13.0",
                "examples": [
                  "dist/notes.js"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "entry"
            ]
          },
          "description": "Pane tabs, offered by the pane’s + menu.",
          "x-since": "0.13.0",
          "x-tier": "ui"
        },
        "doors": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "title": "DoorContribution",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Id, unique within this point.",
                "x-since": "0.13.0",
                "examples": [
                  "notes"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "What Studio calls it.",
                "x-since": "0.13.0",
                "examples": [
                  "Notes"
                ]
              },
              "icon": {
                "type": "string",
                "maxLength": 32,
                "enum": [
                  "extension",
                  "chat",
                  "branch",
                  "folder",
                  "schedule",
                  "spark",
                  "lock",
                  "settings",
                  "check",
                  "warning",
                  "copy",
                  "notes"
                ],
                "description": "Glyph beside the title. Defaults to `extension`.",
                "x-since": "0.13.0",
                "examples": [
                  "notes"
                ]
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:<>\"|?*\\u0000-\\u001f]+(?:\\.[Jj][Ss]|\\.[Mm][Jj][Ss])$",
                "description": "What the door draws when it is open. A `.js` or `.mjs` module whose `mount(root, studio)` draws into `root` and may return a cleanup function.",
                "x-since": "0.13.0",
                "examples": [
                  "dist/notes.js"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "entry"
            ]
          },
          "description": "Full-window surfaces, opened from the Extensions drawer.",
          "x-since": "0.13.0",
          "x-tier": "ui"
        },
        "settingsSections": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "title": "SettingsSectionContribution",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Id, unique within this point.",
                "x-since": "0.13.0",
                "examples": [
                  "notes"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "What Studio calls it.",
                "x-since": "0.13.0",
                "examples": [
                  "Notes"
                ]
              },
              "icon": {
                "type": "string",
                "maxLength": 32,
                "enum": [
                  "extension",
                  "chat",
                  "branch",
                  "folder",
                  "schedule",
                  "spark",
                  "lock",
                  "settings",
                  "check",
                  "warning",
                  "copy",
                  "notes"
                ],
                "description": "Glyph beside the title. Defaults to `extension`.",
                "x-since": "0.13.0",
                "examples": [
                  "notes"
                ]
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:<>\"|?*\\u0000-\\u001f]+(?:\\.[Jj][Ss]|\\.[Mm][Jj][Ss])$",
                "description": "What the section draws in Settings. A `.js` or `.mjs` module whose `mount(root, studio)` draws into `root` and may return a cleanup function.",
                "x-since": "0.13.0",
                "examples": [
                  "dist/notes.js"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "entry"
            ]
          },
          "description": "Sections in Settings.",
          "x-since": "0.13.0",
          "x-tier": "ui"
        },
        "syntaxes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "title": "SyntaxContribution",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Language id, unique among this extension’s syntaxes. A chat code block whose fence names it (```gleam), or one of its extensions without the dot, is highlighted with it.",
                "x-since": "0.13.0",
                "examples": [
                  "gleam"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "The language’s name.",
                "x-since": "0.13.0",
                "examples": [
                  "Gleam"
                ]
              },
              "scopeName": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_+-]+(?:\\.[A-Za-z0-9_+-]+)+$",
                "description": "The grammar’s root scope, unique among this extension’s syntaxes; the grammar file’s own `scopeName` must match.",
                "x-since": "0.13.0",
                "examples": [
                  "source.gleam"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:<>\"|?*\\u0000-\\u001f]+(?:\\.[Jj][Ss][Oo][Nn])$",
                "description": "A TextMate grammar in JSON, at most 1 MiB. Keys a TextMate engine does not read are dropped; every `#name` it includes must name a rule in a repository.",
                "x-since": "0.13.0",
                "examples": [
                  "syntaxes/gleam.tmLanguage.json"
                ]
              },
              "configuration": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:<>\"|?*\\u0000-\\u001f]+(?:\\.[Jj][Ss][Oo][Nn])$",
                "description": "A language configuration, at most 64 KiB: `comments`, `brackets`, `autoClosingPairs` and `surroundingPairs`, which the editor reads.",
                "x-since": "0.13.0",
                "examples": [
                  "syntaxes/language-configuration.json"
                ]
              },
              "extensions": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64,
                  "pattern": "^\\.[A-Za-z0-9_+-][A-Za-z0-9_.+-]*$"
                },
                "description": "File-name suffixes the editor opens in this language, ignoring case. A longer suffix wins over a shorter one, and one of Studio’s own languages that drives completions (TypeScript, JavaScript, JSON, CSS, SCSS, Less, HTML, Markdown) is never replaced.",
                "x-since": "0.13.0",
                "examples": [
                  [
                    ".gleam"
                  ]
                ]
              },
              "filenames": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001f]+$"
                },
                "description": "Exact file names the editor opens in this language, ignoring case; a name wins over any suffix.",
                "x-since": "0.13.0",
                "examples": [
                  [
                    "gleam.toml"
                  ]
                ]
              }
            },
            "required": [
              "id",
              "title",
              "scopeName",
              "path"
            ]
          },
          "description": "Syntax highlighting for a language, in chat code blocks and the editor.",
          "x-since": "0.13.0",
          "x-tier": "content"
        },
        "customEditors": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "title": "CustomEditorContribution",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Id, unique among this extension’s editors.",
                "x-since": "0.13.0",
                "examples": [
                  "todo"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Its name, in the editor’s Open with menu.",
                "x-since": "0.13.0",
                "examples": [
                  "Todo list"
                ]
              },
              "icon": {
                "type": "string",
                "maxLength": 32,
                "enum": [
                  "extension",
                  "chat",
                  "branch",
                  "folder",
                  "schedule",
                  "spark",
                  "lock",
                  "settings",
                  "check",
                  "warning",
                  "copy",
                  "notes"
                ],
                "description": "Glyph beside its name. Defaults to `extension`.",
                "x-since": "0.13.0",
                "examples": [
                  "notes"
                ]
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:<>\"|?*\\u0000-\\u001f]+(?:\\.[Jj][Ss]|\\.[Mm][Jj][Ss])$",
                "description": "What the editor draws, in a frame of its own in the file’s tab: a `.js` or `.mjs` module whose `mount(root, studio)` draws into `root`. Its `studio.document` holds the file’s content and takes its edits; Studio keeps the unsaved state, saves and watches the file, and the frame never gets a path.",
                "x-since": "0.13.0",
                "examples": [
                  "dist/todo.js"
                ]
              },
              "extensions": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64,
                  "pattern": "^\\.[A-Za-z0-9_+-][A-Za-z0-9_.+-]*$"
                },
                "description": "File-name suffixes it opens, with the dot, ignoring case. A longer suffix (`.todo.json`) wins over a shorter one (`.json`), and a file named only the suffix never matches. Give `extensions`, `filenames` or both.",
                "x-since": "0.13.0",
                "examples": [
                  [
                    ".todo"
                  ]
                ]
              },
              "filenames": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001f]+$"
                },
                "description": "Exact file names it opens, ignoring case; a name wins over any suffix.",
                "x-since": "0.13.0",
                "examples": [
                  [
                    "TODO"
                  ]
                ]
              },
              "priority": {
                "type": "string",
                "maxLength": 16,
                "enum": [
                  "default",
                  "option"
                ],
                "description": "`default` (the default) opens matching files in this editor; `option` opens them in Studio’s text editor and offers this one under Open with. Files Studio’s text editor is for (such as `.json`, `.ts`, `.md`, `.yaml`, `.env` and lockfiles) are always `option`; a longer suffix such as `.sketch.json` is not one of them. Either way the person can reopen the file in the text editor.",
                "x-since": "0.13.0"
              },
              "contentKind": {
                "type": "string",
                "maxLength": 16,
                "enum": [
                  "text",
                  "bytes"
                ],
                "description": "`text` (the default) hands the editor the file as UTF-8 text and takes whole-text edits; `bytes` hands it the raw bytes, for a binary format, and takes whole-byte edits.",
                "x-since": "0.13.0"
              }
            },
            "required": [
              "id",
              "title",
              "entry"
            ]
          },
          "description": "Editors for files of a type, drawn in the file’s tab. Needs the `workspace-files:read` permission, and `workspace-files:write` to save; without it the file opens read only.",
          "x-since": "0.13.0",
          "x-tier": "ui"
        },
