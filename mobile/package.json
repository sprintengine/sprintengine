{
  "name": "@sprintengine/mobile",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "node -e \"require('fs').rmSync('.mobile-test-build',{recursive:true,force:true})\" && eslint .",
    "test:mobile": "node -e \"require('fs').rmSync('.mobile-test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node scripts/run-mobile-tests.cjs && node -e \"require('fs').rmSync('.mobile-test-build',{recursive:true,force:true})\"",
    "test:runtime": "node -e \"require('fs').rmSync('.mobile-test-build',{recursive:true,force:true})\" && tsc -p tsconfig.runtime-test.json && node scripts/run-runtime-tests.cjs && node -e \"require('fs').rmSync('.mobile-test-build',{recursive:true,force:true})\"",
    "ci": "npm run typecheck && npm run lint && npm run lint:tokens && npm run test:mobile && npm run test:runtime",
    "lint:tokens": "node scripts/lint-design-tokens.mjs --selftest && node scripts/lint-design-tokens.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "build:renderer": "node scripts/build-rich-renderer.mjs"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~55.0.31",
    "expo-camera": "~55.0.23",
    "expo-clipboard": "~55.0.13",
    "expo-crypto": "~55.0.19",
    "expo-file-system": "~55.0.26",
    "expo-haptics": "~55.0.18",
    "expo-image-picker": "~55.0.24",
    "expo-intent-launcher": "~55.0.16",
    "expo-secure-store": "^55.0.18",
    "expo-speech-recognition": "3.1.3",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.5",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "katex": "0.19.1",
    "mermaid": "12.2.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "markdown-it": "^14.3.3"
  }
}
